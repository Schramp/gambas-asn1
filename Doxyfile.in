PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "Modern C++20 ASN.1 compiler and runtime"

OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIR@"
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO

# Input
INPUT                  = "@PROJECT_SOURCE_DIR@/runtime" \
                         "@PROJECT_SOURCE_DIR@/compiler/src"
RECURSIVE              = YES
FILE_PATTERNS          = *.cpp *.hpp *.h

# Extraction
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# Output formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

# Graphs (Graphviz dot, detected by CMake)
HAVE_DOT               = @DOXYGEN_HAVE_DOT@
DOT_PATH               = "@DOXYGEN_DOT_PATH@"

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

# Warnings
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
QUIET                  = YES
WARNINGS               = YES
# Any warning (an undocumented parameter of a documented function, a stale
# @param, an unresolvable link) fails the doxygen target, so CI catches it.
WARN_AS_ERROR          = FAIL_ON_WARNINGS
