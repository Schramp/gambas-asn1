/* RE/flex lexer for ASN.1, adapted from asn1c's asn1p_l.l
 * Bison C++ bridge: returns yy::parser::symbol_type tokens.
 */

%top{
#include <string>
#include <cstdlib>
#include <cerrno>
#include <cmath>
#include <climits>
#include "asn1.tab.hh"   /* generated by Bison */
}

%option bison-complete
%option bison-locations
%option noyywrap
%option stack
%option yylineno

/* Start conditions */
%x dash_comment
%x idash_comment
%x cpp_comment
%x quoted
%x opaque
%x encoding_control
%x with_syntax
%x extended_values

NL      [\r\v\f\n]
WSP     [\t\r\v\f\n ]

%class{
 public:
  std::string quoted_buf_;
  std::string filename_;
  bool extended_values_{false};
  void push_opaque_state();
  void push_with_syntax_state();
  void push_encoding_control_state();
  std::string str() const;
%}

%%

<INITIAL>"\xef\xbb\xbf"   /* Skip UTF-8 BOM */

-{3,}/[\r\n]              /* Immediately terminated long comment */
-{3,}/[^-\r\n]            { push_state(idash_comment); }
<idash_comment>-{3,}      { pop_state(); }

--<[ \t]*ASN1C.RepresentAsPointer[ \t]*>--   /* ignore compiler directive */

<INITIAL,with_syntax>--       { push_state(dash_comment); }
<dash_comment,idash_comment>[\r\v\f\n]      { pop_state(); }
<dash_comment,idash_comment>--              { pop_state(); }
<dash_comment,idash_comment>-               /* eat single dash */
<dash_comment,idash_comment>[^\r\v\f\n-]+   /* eat */

<INITIAL,cpp_comment,with_syntax>"/*"   { push_state(cpp_comment); }
<cpp_comment>[^*/]+  /* eat */
<cpp_comment>"*/"    { pop_state(); }
<cpp_comment>.       /* eat */

<opaque>"{"         { push_state(opaque); return yy::parser::make_TOK_opaque(str(), location()); }
<opaque>"}"         { pop_state();        return yy::parser::make_TOK_opaque(str(), location()); }
<opaque>[^{}:=]+    { return yy::parser::make_TOK_opaque(str(), location()); }
<opaque>"::="       { return yy::parser::make_TOK_PPEQ(location()); }
<opaque>[:=]        { return yy::parser::make_TOK_opaque(str(), location()); }

\"[^\"]*        {
                    /* Start of quoted string — strip opening quote */
                    quoted_buf_ = std::string(text() + 1);
                    push_state(quoted);
                }
<quoted>\"\"        { quoted_buf_ += '"'; }
<quoted>[^\"]+  { quoted_buf_ += std::string(text()); }
<quoted>\"      { pop_state(); return yy::parser::make_TOK_cstring(quoted_buf_, location()); }

<encoding_control>ENCODING-CONTROL                    { pop_state(); }
<encoding_control>END                                  { pop_state(); return yy::parser::make_TOK_END(location()); }
<encoding_control>[\t\r\v\f\n ]+                       /* skip whitespace */
<encoding_control>"--"[^\r\n]*                         /* skip line comments */
<encoding_control>"::="                                { return yy::parser::make_TOK_PPEQ(location()); }
<encoding_control>OCTET                                { return yy::parser::make_TOK_OCTET(location()); }
<encoding_control>STRING                               { return yy::parser::make_TOK_STRING(location()); }
<encoding_control>[a-z][a-zA-Z0-9]*([-][a-zA-Z0-9]+)* { return yy::parser::make_TOK_identifier(str(), location()); }
<encoding_control>[A-Z][A-Za-z0-9]*([-][A-Za-z0-9]+)* { return yy::parser::make_TOK_typereference(str(), location()); }
<encoding_control>.                                    /* ignore for error recovery */

<extended_values>"#BIT STRING"   {
    pop_state();
    return yy::parser::make_TOK_ExtValue_BIT_STRING(location());
}

'[0-9A-F \t\r\v\f\n]+'H    {
    return yy::parser::make_TOK_hstring(str(), location());
}
'[01 \t\r\v\f\n]+'B        {
    return yy::parser::make_TOK_bstring(str(), location());
}

[{][ \t\r\v\f\n]*[0-7][,][ \t\r\v\f\n]*[0-9]+[ \t\r\v\f\n]*[}]    {
    /* X.680 #37.14 tuple: {col, row} */
    long long col = -1, row = -1;
    const char* p = text();
    while (*p && (*p < '0' || *p > '9')) p++;
    col = std::strtoll(p, nullptr, 10);
    while (*p >= '0' && *p <= '9') p++;
    while (*p && (*p < '0' || *p > '9')) p++;
    row = std::strtoll(p, nullptr, 10);
    return yy::parser::make_TOK_tuple((col << 4) | row, location());
}

[{][ \t\r\v\f\n]*[0-9]+[,][ \t\r\v\f\n]*[0-9]+[,][ \t\r\v\f\n]*[0-9]+[,][ \t\r\v\f\n]*[0-9]+[ \t\r\v\f\n]*[}]    {
    /* X.680 #37.12 quadruple: {group, plane, row, cell} */
    long long v[4] = {-1,-1,-1,-1};
    const char* p = text();
    for (int i = 0; i < 4; i++) {
        while (*p && (*p < '0' || *p > '9')) p++;
        v[i] = std::strtoll(p, nullptr, 10);
        while (*p >= '0' && *p <= '9') p++;
    }
    return yy::parser::make_TOK_quadruple((v[0]<<24)|(v[1]<<16)|(v[2]<<8)|v[3], location());
}

-[1-9][0-9]*    {
    errno = 0;
    long long v = std::strtoll(text(), nullptr, 10);
    if (errno == ERANGE) v = LLONG_MIN;
    return yy::parser::make_TOK_number_negative(v, location());
}

[1-9][0-9]*     {
    errno = 0;
    long long v = std::strtoll(text(), nullptr, 10);
    if (errno == ERANGE) v = LLONG_MAX;
    return yy::parser::make_TOK_number(v, location());
}

"0"             { return yy::parser::make_TOK_number(0LL, location()); }

[-+]?[0-9]+[.]?([eE][-+]?)?[0-9]+  {
    errno = 0;
    double v = std::strtod(text(), nullptr);
    if (errno == ERANGE) v = (v > 0) ? HUGE_VAL : -HUGE_VAL;
    return yy::parser::make_TOK_realnumber(v, location());
}

ABSENT              { return yy::parser::make_TOK_ABSENT(location()); }
ALL                 { return yy::parser::make_TOK_ALL(location()); }
ANY                 { return yy::parser::make_TOK_ANY(location()); }
APPLICATION         { return yy::parser::make_TOK_APPLICATION(location()); }
AUTOMATIC           { return yy::parser::make_TOK_AUTOMATIC(location()); }
BEGIN               {
    if (extended_values_) push_state(extended_values);
    return yy::parser::make_TOK_BEGIN(location());
}
BIT                 { return yy::parser::make_TOK_BIT(location()); }
BMPString           { return yy::parser::make_TOK_BMPString(location()); }
BOOLEAN             { return yy::parser::make_TOK_BOOLEAN(location()); }
BY                  { return yy::parser::make_TOK_BY(location()); }
CHARACTER           { return yy::parser::make_TOK_CHARACTER(location()); }
CHOICE              { return yy::parser::make_TOK_CHOICE(location()); }
CLASS               { return yy::parser::make_TOK_CLASS(location()); }
COMPONENT           { return yy::parser::make_TOK_COMPONENT(location()); }
COMPONENTS          { return yy::parser::make_TOK_COMPONENTS(location()); }
CONSTRAINED         { return yy::parser::make_TOK_CONSTRAINED(location()); }
CONTAINING          { return yy::parser::make_TOK_CONTAINING(location()); }
DEFAULT             { return yy::parser::make_TOK_DEFAULT(location()); }
DEFINED             { return yy::parser::make_TOK_DEFINED(location()); }
DEFINITIONS         { return yy::parser::make_TOK_DEFINITIONS(location()); }
EMBEDDED            { return yy::parser::make_TOK_EMBEDDED(location()); }
ENCODED             { return yy::parser::make_TOK_ENCODED(location()); }
ENCODING-CONTROL    { return yy::parser::make_TOK_ENCODING_CONTROL(location()); }
END                 {
    if (start() == extended_values) pop_state();
    return yy::parser::make_TOK_END(location());
}
ENUMERATED          { return yy::parser::make_TOK_ENUMERATED(location()); }
EXCEPT              { return yy::parser::make_TOK_EXCEPT(location()); }
EXPLICIT            { return yy::parser::make_TOK_EXPLICIT(location()); }
EXPORTS             { return yy::parser::make_TOK_EXPORTS(location()); }
EXTENSIBILITY       { return yy::parser::make_TOK_EXTENSIBILITY(location()); }
FALSE               { return yy::parser::make_TOK_FALSE(location()); }
FROM                { return yy::parser::make_TOK_FROM(location()); }
GeneralizedTime     { return yy::parser::make_TOK_GeneralizedTime(location()); }
GeneralString       { return yy::parser::make_TOK_GeneralString(location()); }
GraphicString       { return yy::parser::make_TOK_GraphicString(location()); }
IA5String           { return yy::parser::make_TOK_IA5String(location()); }
IDENTIFIED          { return yy::parser::make_TOK_IDENTIFIED(location()); }
IDENTIFIER          { return yy::parser::make_TOK_IDENTIFIER(location()); }
IMPLICIT            { return yy::parser::make_TOK_IMPLICIT(location()); }
IMPLIED             { return yy::parser::make_TOK_IMPLIED(location()); }
IMPORTS             { return yy::parser::make_TOK_IMPORTS(location()); }
INCLUDES            { return yy::parser::make_TOK_INCLUDES(location()); }
INSTANCE            { return yy::parser::make_TOK_INSTANCE(location()); }
INSTRUCTIONS        { return yy::parser::make_TOK_INSTRUCTIONS(location()); }
INTEGER             { return yy::parser::make_TOK_INTEGER(location()); }
INTERSECTION        { return yy::parser::make_TOK_INTERSECTION(location()); }
ISO646String        { return yy::parser::make_TOK_ISO646String(location()); }
MAX                 { return yy::parser::make_TOK_MAX(location()); }
MIN                 { return yy::parser::make_TOK_MIN(location()); }
MINUS-INFINITY      { return yy::parser::make_TOK_MINUS_INFINITY(location()); }
NULL                { return yy::parser::make_TOK_NULL(location()); }
NumericString       { return yy::parser::make_TOK_NumericString(location()); }
OBJECT              { return yy::parser::make_TOK_OBJECT(location()); }
ObjectDescriptor    { return yy::parser::make_TOK_ObjectDescriptor(location()); }
OCTET               { return yy::parser::make_TOK_OCTET(location()); }
OF                  { return yy::parser::make_TOK_OF(location()); }
OPTIONAL            { return yy::parser::make_TOK_OPTIONAL(location()); }
PATTERN             { return yy::parser::make_TOK_PATTERN(location()); }
PDV                 { return yy::parser::make_TOK_PDV(location()); }
PLUS-INFINITY       { return yy::parser::make_TOK_PLUS_INFINITY(location()); }
PRESENT             { return yy::parser::make_TOK_PRESENT(location()); }
PrintableString     { return yy::parser::make_TOK_PrintableString(location()); }
PRIVATE             { return yy::parser::make_TOK_PRIVATE(location()); }
REAL                { return yy::parser::make_TOK_REAL(location()); }
RELATIVE-OID        { return yy::parser::make_TOK_RELATIVE_OID(location()); }
SEQUENCE            { return yy::parser::make_TOK_SEQUENCE(location()); }
SET                 { return yy::parser::make_TOK_SET(location()); }
SIZE                { return yy::parser::make_TOK_SIZE(location()); }
STRING              { return yy::parser::make_TOK_STRING(location()); }
SYNTAX              { return yy::parser::make_TOK_SYNTAX(location()); }
T61String           { return yy::parser::make_TOK_T61String(location()); }
TAGS                { return yy::parser::make_TOK_TAGS(location()); }
TeletexString       { return yy::parser::make_TOK_TeletexString(location()); }
TRUE                { return yy::parser::make_TOK_TRUE(location()); }
UNION               { return yy::parser::make_TOK_UNION(location()); }
UNIQUE              { return yy::parser::make_TOK_UNIQUE(location()); }
UNIVERSAL           { return yy::parser::make_TOK_UNIVERSAL(location()); }
UniversalString     { return yy::parser::make_TOK_UniversalString(location()); }
UTCTime             { return yy::parser::make_TOK_UTCTime(location()); }
UTF8String          { return yy::parser::make_TOK_UTF8String(location()); }
VideotexString      { return yy::parser::make_TOK_VideotexString(location()); }
VisibleString       { return yy::parser::make_TOK_VisibleString(location()); }
WITH                { return yy::parser::make_TOK_WITH(location()); }
SUCCESSORS          { return yy::parser::make_TOK_SUCCESSORS(location()); }
DESCENDANTS         { return yy::parser::make_TOK_DESCENDANTS(location()); }

<INITIAL,with_syntax>&[A-Z][A-Za-z0-9]*([-][A-Za-z0-9]+)*  {
    return yy::parser::make_TOK_typefieldreference(str(), location());
}
<INITIAL,with_syntax>&[a-z][a-zA-Z0-9]*([-][a-zA-Z0-9]+)*  {
    return yy::parser::make_TOK_valuefieldreference(str(), location());
}

[a-z][a-zA-Z0-9]*([-][a-zA-Z0-9]+)*    {
    return yy::parser::make_TOK_identifier(str(), location());
}

[A-Z][A-Z0-9]*([-][A-Z0-9]+)*  {
    return yy::parser::make_TOK_capitalreference(str(), location());
}

[A-Z][A-Za-z0-9]*([-][A-Za-z0-9]+)*    {
    return yy::parser::make_TOK_typereference(str(), location());
}

<INITIAL>"::="  { return yy::parser::make_TOK_PPEQ(location()); }

"..."   { return yy::parser::make_TOK_ThreeDots(location()); }
".."    { return yy::parser::make_TOK_TwoDots(location()); }

<with_syntax>[A-Z][A-Za-z0-9]*([-][A-Za-z0-9]+)* { return yy::parser::make_TOK_Literal(str(), location()); }
<with_syntax>","                              { return yy::parser::make_TOK_Literal(",", location()); }
<with_syntax>"{"                              { push_state(with_syntax); return yy::parser::make_TOK_Literal("{", location()); }
<with_syntax>"["                              { return yy::parser::symbol_type('[', location()); }
<with_syntax>"]"                              { return yy::parser::symbol_type(']', location()); }
<with_syntax>[\t\r\v\f\n ]+                   { return yy::parser::make_TOK_whitespace(str(), location()); }
<with_syntax>"}"                              { pop_state(); if (start() == with_syntax) return yy::parser::make_TOK_Literal("}", location()); return yy::parser::symbol_type('}', location()); }

<INITIAL>{WSP}+     /* Ignore whitespace */

"[["    { return yy::parser::make_TOK_VBracketLeft(location()); }
"]]"    { return yy::parser::make_TOK_VBracketRight(location()); }

[(){},;:|!.&@\[\]^]     {
    return yy::parser::symbol_type(text()[0], location());
}

<INITIAL,with_syntax,extended_values>.    {
    /* Unexpected character — skip and continue */
}

<*><<EOF>>  { return yy::parser::make_YYEOF(location()); }

%%

/* Member functions for lexer state hacks (called from parser actions) */
void Lexer::push_opaque_state()         { push_state(opaque); }
void Lexer::push_with_syntax_state()    { push_state(with_syntax); }
void Lexer::push_encoding_control_state() { push_state(encoding_control); }

std::string Lexer::str() const { return std::string(text()); }
