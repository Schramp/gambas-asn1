# Called by ctest: -DCOMPILER=<asn1cpp> -DSRC=<tests/asn1/stale> -DOUT=<dir>
# Generates two modules into per-module Java packages, then one, and
# checks that the dropped module's directory and the dropped type's file
# are removed while a file no run generated stays; then switches to the
# flat layout and checks the module directories are gone.
foreach(v COMPILER SRC OUT)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "check_stale_files.cmake: ${v} not set")
    endif()
endforeach()
file(REMOVE_RECURSE "${OUT}")
file(WRITE "${OUT}/Mine/Mine.java" "class Mine {}\n")
function(run)
    execute_process(COMMAND "${COMPILER}" --target=java --package=g ${ARGN} -o "${OUT}"
                    RESULT_VARIABLE rc OUTPUT_QUIET)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "asn1cpp failed (${rc}): ${ARGN}")
    endif()
endfunction()
function(expect path present)
    if(present AND NOT EXISTS "${OUT}/${path}")
        message(FATAL_ERROR "expected ${path}")
    elseif(NOT present AND EXISTS "${OUT}/${path}")
        message(FATAL_ERROR "expected ${path} to be removed")
    endif()
endfunction()
run("${SRC}/two_modules.asn1")
expect(ModB/BType.java TRUE)
expect(ModA/Lim.java TRUE)
run("${SRC}/one_module.asn1")
expect(ModA/AType.java TRUE)
expect(ModA/Lim.java FALSE)
expect(ModB/BType.java FALSE)
expect(ModB FALSE)
expect(Mine/Mine.java TRUE)
run(--flat-package "${SRC}/one_module.asn1")
expect(AType.java TRUE)
expect(ModA FALSE)
expect(Mine/Mine.java TRUE)
message(STATUS "stale files removed, user file kept")
