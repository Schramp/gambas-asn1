# Called by ctest: -DCOMPILER=<asn1cpp> -DSRC=<tests/asn1/stale> -DOUT=<dir>
# Generates two modules into per-module Java packages, then one: without
# --remove-stale the dropped module's and type's files stay, with it they
# go (through the manifest, which kept listing them). Files no run
# generated stay throughout, also directly in -o and in a module directory
# the compiler writes. Then switches to the flat layout, and checks that a
# hand-written .rs in a Rust output directory is no module of lib.rs.
foreach(v COMPILER SRC OUT)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "check_stale_files.cmake: ${v} not set")
    endif()
endforeach()
file(REMOVE_RECURSE "${OUT}")
set(user_files Hand.java Mine/Mine.java ModA/Own.java)
foreach(f ${user_files})
    get_filename_component(stem "${f}" NAME_WE)
    file(WRITE "${OUT}/java/${f}" "class ${stem} {}\n")
endforeach()
function(run)
    execute_process(COMMAND "${COMPILER}" ${ARGN} RESULT_VARIABLE rc OUTPUT_QUIET)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "asn1cpp failed (${rc}): ${ARGN}")
    endif()
endfunction()
function(java)
    run(--target=java --package=g ${ARGN} -o "${OUT}/java")
endfunction()
function(expect path present)
    if(present AND NOT EXISTS "${OUT}/${path}")
        message(FATAL_ERROR "expected ${path}")
    elseif(NOT present AND EXISTS "${OUT}/${path}")
        message(FATAL_ERROR "expected ${path} to be removed")
    endif()
endfunction()
function(expect_user_files)
    foreach(f ${user_files})
        expect(java/${f} TRUE)
    endforeach()
endfunction()
java("${SRC}/two_modules.asn1")
expect(java/ModB/BType.java TRUE)
expect(java/ModA/Lim.java TRUE)
expect_user_files()
java("${SRC}/one_module.asn1")
expect(java/ModA/AType.java TRUE)
expect(java/ModA/Lim.java TRUE)
expect(java/ModB/BType.java TRUE)
expect_user_files()
java(--remove-stale "${SRC}/one_module.asn1")
expect(java/ModA/AType.java TRUE)
expect(java/ModA/Lim.java FALSE)
expect(java/ModB/BType.java FALSE)
expect(java/ModB FALSE)
expect_user_files()
java(--remove-stale --flat-package "${SRC}/one_module.asn1")
expect(java/AType.java TRUE)
expect(java/ModA/AType.java FALSE)
expect_user_files()

file(WRITE "${OUT}/rust/Hand.rs" "pub struct Hand;\n")
run(--target=rust "${SRC}/one_module.asn1" -o "${OUT}/rust")
expect(rust/Hand.rs TRUE)
file(READ "${OUT}/rust/lib.rs" lib_rs)
if(lib_rs MATCHES "Hand")
    message(FATAL_ERROR "lib.rs declares the hand-written Hand.rs:\n${lib_rs}")
endif()
if(NOT lib_rs MATCHES "pub mod AType;")
    message(FATAL_ERROR "lib.rs lacks the generated AType:\n${lib_rs}")
endif()
message(STATUS "stale files removed only with --remove-stale, user files kept")
