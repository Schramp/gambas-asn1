-- CHOICE alternatives whose type reaches the CHOICE again (X.680 §3.6.55):
-- directly (neg), through a SEQUENCE (Sum) and through an inline SEQUENCE
-- OF (list). The CHOICE's header must not need those types complete.
ChoiceCycleTest DEFINITIONS AUTOMATIC TAGS ::= BEGIN

Expr ::= CHOICE {
    num   INTEGER,
    neg   Expr,
    sum   Sum,
    list  SEQUENCE OF Expr
}

Sum ::= SEQUENCE { l Expr, r Expr }

END
