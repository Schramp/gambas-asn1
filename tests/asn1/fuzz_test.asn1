-- Schema for the in-tree BER fuzz test (tests/seq/test_fuzz_ber.cpp).
-- Covers SEQUENCE / SEQUENCE OF / CHOICE OPTIONAL,
-- INTEGER + OCTET/BIT STRING + IA5/Printable string with SIZE constraints,
-- UInteger (semi-constrained INTEGER), REAL, NULL, OID, UTCTime, GeneralizedTime.
FuzzTest DEFINITIONS ::= BEGIN

  Inner ::= SEQUENCE {
    n       INTEGER (0..1000),
    counter INTEGER (0..MAX),    -- semi-constrained: exercises fill_primitive UInteger path
    s       OCTET STRING (SIZE(0..32)),
    txt     IA5String (SIZE(0..16)) OPTIONAL,
    flag    BOOLEAN
  }

  Pick ::= CHOICE {
    a   [0] INTEGER (0..15),
    b   [1] OCTET STRING (SIZE(1..16)),
    c   [2] BOOLEAN,
    d   [3] PrintableString (SIZE(1..12))
  }

  Bag ::= SEQUENCE {
    label    PrintableString (SIZE(1..16)),
    items    SEQUENCE (SIZE(0..6)) OF Inner,
    pick     Pick OPTIONAL,
    flags    BIT STRING (SIZE(8)),
    -- context tags [4..8]: one per primitive type lacking fuzz coverage
    r        [4] IMPLICIT REAL                OPTIONAL,
    nothing  [5] IMPLICIT NULL                OPTIONAL,
    oid      [6] IMPLICIT OBJECT IDENTIFIER   OPTIONAL,
    utc      [7] IMPLICIT UTCTime             OPTIONAL,
    gtime    [8] IMPLICIT GeneralizedTime     OPTIONAL
  }

END
