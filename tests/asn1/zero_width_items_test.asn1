-- PER SEQUENCE OF/SET OF elements encoded in zero bits (NULL, X.691 §18;
-- an INTEGER with a single value, §11.1.3). Their count costs a few octets
-- of length determinant and the elements none, so a decoder refuses a list
-- counting more than its limit (200, as asn1c) once such an element shows
-- up. Elements of one bit or more, and many short lists, stay unlimited.

ZeroWidthItemsTest DEFINITIONS AUTOMATIC TAGS ::= BEGIN

    Nulls ::= SEQUENCE OF NULL

    Fives ::= SEQUENCE (SIZE(0..60000)) OF INTEGER (5..5)

    Flags ::= SEQUENCE OF BOOLEAN

    Rows ::= SEQUENCE OF Nulls

END
