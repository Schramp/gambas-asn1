-- Cross-module value reference in constraint bounds (issue #89 / codegen fix).
-- ModLimits defines named integer constants; ModConstrained uses them as
-- constraint bounds.  The generator must look up the value in the correct
-- module (ModLimits.maxCount = 10, ModLimits.baseOffset = 5) rather than
-- using the flat global_ map, which is unsafe under same-name collisions.

ModLimits DEFINITIONS ::= BEGIN
    EXPORTS maxCount, baseOffset;
    maxCount    INTEGER ::= 10
    baseOffset  INTEGER ::= 5
END

ModConstrained DEFINITIONS ::= BEGIN
    IMPORTS maxCount, baseOffset FROM ModLimits;

    -- Uses ModLimits.maxCount as upper bound; generator must resolve to 10.
    CountedField ::= SEQUENCE {
        count   INTEGER (0..maxCount),
        offset  INTEGER (baseOffset..maxCount)
    }
END
