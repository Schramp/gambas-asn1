<?xml version="1.0" encoding="UTF-8"?>
<!--
  contact-book example as a Maven project: `mvn compile` runs asn1cpp on
  ../contact.asn1 (generate-sources phase) and compiles the generated Java,
  with ../java/Main.java, against the gambasasn1-wire artifact.

  Before generating, the build asks the compiler for its version and
  compares it with the runtime version (a -SNAPSHOT or other qualifier
  ignored). When the compiler is missing or another version, the build
  stops with the checkout, build and install steps for the right one:
  generated code uses its own compiler's runtime API.

  Properties:
    gambasasn1.version   runtime version, and the compiler version required
    asn1cpp.executable   the compiler (default: asn1cpp on PATH, where
                         cmake's install step puts it)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>example</groupId>
  <artifactId>contact-book</artifactId>
  <version>1</version>

  <properties>
    <gambasasn1.version>0.1.0-SNAPSHOT</gambasasn1.version>
    <asn1cpp.executable>asn1cpp</asn1cpp.executable>
    <asn1cpp.project>https://github.com/Schramp/gambas-asn1</asn1cpp.project>
    <asn1cpp.generated>${project.build.directory}/generated-sources/asn1cpp</asn1cpp.generated>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.schramp.gambasasn1</groupId>
      <artifactId>gambasasn1-wire</artifactId>
      <version>${gambasasn1.version}</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>../java</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>asn1cpp-base-version</id>
            <phase>initialize</phase>
            <goals>
              <goal>regex-property</goal>
            </goals>
            <configuration>
              <name>asn1cpp.requiredVersion</name>
              <value>${gambasasn1.version}</value>
              <regex>-.*$</regex>
              <replacement></replacement>
              <failIfNoMatch>false</failIfNoMatch>
            </configuration>
          </execution>
          <execution>
            <id>asn1cpp-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${asn1cpp.generated}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>asn1cpp-version</id>
            <phase>initialize</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <exec executable="${asn1cpp.executable}" failifexecutionfails="false"
                      outputproperty="asn1cpp.found" errorproperty="asn1cpp.err">
                  <arg value="--version"/>
                </exec>
                <property name="asn1cpp.found" value="no compiler at '${asn1cpp.executable}'"/>
                <condition property="asn1cpp.shown" value="${asn1cpp.found}"
                           else="'${asn1cpp.executable}', which predates --version">
                  <length string="${asn1cpp.found}" trim="true" when="greater" length="0"/>
                </condition>
                <condition property="asn1cpp.ref" value="main"
                           else="java-runtime-v${asn1cpp.requiredVersion}">
                  <contains string="${gambasasn1.version}" substring="-SNAPSHOT"/>
                </condition>
                <condition property="asn1cpp.ok">
                  <equals arg1="${asn1cpp.found}" arg2="asn1cpp ${asn1cpp.requiredVersion}" trim="true"/>
                </condition>
                <fail unless="asn1cpp.ok">
asn1cpp ${asn1cpp.requiredVersion} is required (runtime gambasasn1-wire ${gambasasn1.version}).
Found: ${asn1cpp.shown}

Build and install it from ${asn1cpp.project}, at ${asn1cpp.ref}:

  git clone ${asn1cpp.project}.git
  cd gambas-asn1
  git checkout ${asn1cpp.ref}
  cmake -B build -DCMAKE_BUILD_TYPE=Release
  cmake --build build --parallel
  sudo cmake --install build      # or: cmake --install build --prefix ~/.local

Then put the install prefix's bin/ on PATH, or pass -Dasn1cpp.executable=PATH.
Dependencies and options: ${asn1cpp.project}/blob/${asn1cpp.ref}/INSTALL.md
                </fail>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>asn1cpp</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${asn1cpp.executable}</executable>
              <arguments>
                <argument>-require-version=${gambasasn1.version}</argument>
                <argument>-target=java</argument>
                <argument>-package=contacts</argument>
                <argument>${project.basedir}/../contact.asn1</argument>
                <argument>-o</argument>
                <argument>${asn1cpp.generated}/contacts</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- ../java also holds the plain-javac example's build output. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <includes>
            <include>Main.java</include>
            <include>contacts/**/*.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
