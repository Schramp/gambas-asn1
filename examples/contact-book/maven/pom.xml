<?xml version="1.0" encoding="UTF-8"?>
<!--
  contact-book example as a Maven project: `mvn compile` runs asn1cpp on
  ../contact.asn1 (generate-sources phase) and compiles the generated Java,
  with ../java/Main.java, against the gambasasn1-wire artifact.

  asn1cpp runs with -require-version=${gambasasn1.version}, so the build
  stops when the compiler is not the version of the runtime it compiles
  against: generated code uses its own compiler's runtime API.

  Properties:
    gambasasn1.version   runtime version, and the compiler version required
    asn1cpp.executable   the compiler (default: asn1cpp on PATH, where
                         cmake's install step puts it)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>example</groupId>
  <artifactId>contact-book</artifactId>
  <version>1</version>

  <properties>
    <gambasasn1.version>0.1.0-SNAPSHOT</gambasasn1.version>
    <asn1cpp.executable>asn1cpp</asn1cpp.executable>
    <asn1cpp.generated>${project.build.directory}/generated-sources/asn1cpp</asn1cpp.generated>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.schramp.gambasasn1</groupId>
      <artifactId>gambasasn1-wire</artifactId>
      <version>${gambasasn1.version}</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>../java</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>asn1cpp</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${asn1cpp.executable}</executable>
              <arguments>
                <argument>-require-version=${gambasasn1.version}</argument>
                <argument>-target=java</argument>
                <argument>-package=contacts</argument>
                <argument>${project.basedir}/../contact.asn1</argument>
                <argument>-o</argument>
                <argument>${asn1cpp.generated}/contacts</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- ../java also holds the plain-javac example's build output. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <includes>
            <include>Main.java</include>
            <include>contacts/**/*.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>asn1cpp-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${asn1cpp.generated}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
