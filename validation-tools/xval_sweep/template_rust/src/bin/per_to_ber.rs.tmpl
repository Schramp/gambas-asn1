// per-to-ber — read length-prefixed UPER records (same framing
// ber-to-per, this directory, produces) and re-encode each to BER,
// writing the concatenated (self-delimiting) BER TLVs to stdout.
//
// Materialized by asn1cpp-validation-tools/xval_sweep/xval_sweep.py --
// only when the target type has a `PerValue` impl.
//
// Usage: per-to-ber --type __PDU_TYPE__ [FILE]
use asn1cpp_per::PerValue;
use std::io::{Read, Write};

const TYPES: &[&str] = &["__PDU_TYPE__"];

fn slurp(mut r: impl Read) -> Vec<u8> {
    let mut buf = Vec::new();
    r.read_to_end(&mut buf).expect("read failed");
    buf
}

fn list_types() {
    for t in TYPES {
        eprintln!("  {t}");
    }
}

fn decode_one(type_name: &str, per_bytes: &[u8]) -> Result<Vec<u8>, asn1cpp_per::DecodeError> {
    let mut r = asn1cpp_per::Reader::new(per_bytes);
    match type_name {
        "__PDU_TYPE__" => {
            let mut v = randgen_rust::__PDU_MODULE__::__PDU_IDENT__::default();
            v.per_decode_into(&mut r)?;
            Ok(v.encode())
        }
        _ => unreachable!("checked by caller"),
    }
}

fn main() {
    let mut type_name = String::new();
    let mut input_file: Option<String> = None;
    let mut args = std::env::args().skip(1);
    while let Some(arg) = args.next() {
        if arg == "--type" {
            type_name = args.next().unwrap_or_else(|| {
                eprintln!("--type requires an argument");
                std::process::exit(1);
            });
        } else if !arg.starts_with('-') {
            input_file = Some(arg);
        } else {
            eprintln!("Unknown option: {arg}");
            std::process::exit(1);
        }
    }

    if type_name.is_empty() || type_name == "list" {
        eprintln!("Available types:");
        list_types();
        std::process::exit(if type_name.is_empty() { 1 } else { 0 });
    }
    if !TYPES.contains(&type_name.as_str()) {
        eprintln!("Unknown type: {type_name}\nAvailable:");
        list_types();
        std::process::exit(1);
    }

    let data = match &input_file {
        Some(path) => slurp(std::fs::File::open(path).unwrap_or_else(|e| {
            eprintln!("Cannot open: {path}: {e}");
            std::process::exit(1);
        })),
        None => slurp(std::io::stdin()),
    };

    let mut n = 0;
    let mut errors = 0;
    let mut offset = 0usize;
    let stdout = std::io::stdout();
    let mut out = stdout.lock();

    while offset < data.len() {
        if offset + 4 > data.len() {
            eprintln!("Truncated length prefix at offset {offset}");
            errors += 1;
            break;
        }
        let len = u32::from_be_bytes(data[offset..offset + 4].try_into().unwrap()) as usize;
        offset += 4;
        if offset + len > data.len() {
            eprintln!("Truncated PER record at offset {offset}");
            errors += 1;
            break;
        }
        match decode_one(&type_name, &data[offset..offset + len]) {
            Ok(ber_bytes) => {
                offset += len;
                out.write_all(&ber_bytes).unwrap();
                n += 1;
            }
            Err(e) => {
                eprintln!("PER decode failed record #{n}: {}", e.message);
                errors += 1;
                break;
            }
        }
    }

    eprintln!("{n} records processed, {errors} errors");
    std::process::exit(if errors != 0 { 1 } else { 0 });
}
