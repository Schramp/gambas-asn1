ASN1CPP_ROOT := __ASN1CPP_ROOT__
ASN1_FILES   := __ASN1_FILES__
PDU_TYPE     := __PDU_TYPE__

ASNCPP       := $(ASN1CPP_ROOT)/build/compiler/asn1cpp
RUNTIME_INC  := $(ASN1CPP_ROOT)/runtime/include
RUNTIME_LIB  := $(ASN1CPP_ROOT)/build/runtime/libasn1cpp_runtime.a

GEN_DIR      := gen
LIB          := lib/libtarget.a

CXX      := g++
OPT      ?= -O2
CXXFLAGS := -std=c++20 $(OPT) -I. -I$(GEN_DIR) -I$(RUNTIME_INC)
FMT_LIBS := $(shell pkg-config --libs fmt 2>/dev/null)
LIBS     := $(LIB) $(RUNTIME_LIB) $(FMT_LIBS)

REGISTRY_OBJS := src/type_registry.o src/types.o
PROGRAMS      := randgen ber-to-xer xer-to-ber

all: $(PROGRAMS)

# Codegen: re-runs whenever the schema source(s) or the compiler binary
# change. A stamp file (not GEN_DIR itself) is the make target since
# asn1cpp writes a variable, content-dependent set of files per PDU.
$(GEN_DIR)/.stamp: $(ASN1_FILES) $(ASNCPP)
	@rm -rf $(GEN_DIR)
	@mkdir -p $(GEN_DIR)
	$(ASNCPP) $(ASN1_FILES) -pdu=$(PDU_TYPE) --target=cpp -o $(GEN_DIR)
	@touch $@

# One static lib from every generated .cpp — avoids hand-listing sources,
# same "whatever got generated, compile all of it" approach
# examples/sample.source.ETSI-LI-PS-PDU/Makefile uses for the real schema.
$(LIB): $(GEN_DIR)/.stamp
	@mkdir -p lib obj
	@for f in $(GEN_DIR)/*.cpp; do \
		$(CXX) $(CXXFLAGS) -c -o obj/$$(basename $$f .cpp).o $$f || exit 1; \
	done
	ar rcs $(LIB) obj/*.o

src/type_registry.o: src/type_registry.cpp src/type_registry.hpp
	$(CXX) $(CXXFLAGS) -c -o $@ src/type_registry.cpp

src/types.o: src/types.cpp src/type_registry.hpp $(GEN_DIR)/.stamp
	$(CXX) $(CXXFLAGS) -c -o $@ src/types.cpp

randgen: src/randgen.cpp $(REGISTRY_OBJS) $(LIB) $(RUNTIME_LIB)
	$(CXX) $(CXXFLAGS) -o $@ src/randgen.cpp $(REGISTRY_OBJS) $(LIBS)

ber-to-xer: src/ber-to-xer.cpp $(REGISTRY_OBJS) $(LIB) $(RUNTIME_LIB)
	$(CXX) $(CXXFLAGS) -o $@ src/ber-to-xer.cpp $(REGISTRY_OBJS) $(LIBS)

xer-to-ber: src/xer-to-ber.cpp $(REGISTRY_OBJS) $(LIB) $(RUNTIME_LIB)
	$(CXX) $(CXXFLAGS) -o $@ src/xer-to-ber.cpp $(REGISTRY_OBJS) $(LIBS)

clean:
	rm -rf $(PROGRAMS) $(GEN_DIR) obj lib src/*.o

.PHONY: all clean
